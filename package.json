{
  "name": "tech-radar",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:build": "node scripts/build-content.mjs",
    "build": "npm run content:build && vite build && tsc -b --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run content:build"
  },
  "dependencies": {
    "@tabler/icons-react": "3.51.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
